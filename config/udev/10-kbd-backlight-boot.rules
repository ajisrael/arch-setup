# Set the SMC keyboard backlight to a low-but-on level as soon as the LED
# device appears, so the keys are visible at the LUKS passphrase prompt and at
# boot. The systemd initramfs hook bundles /etc/udev/rules.d into the image on
# every `mkinitcpio -P`, so this rule also applies inside the initramfs.
#
# The floor is 10% of max_brightness. applesmc exposes no brightness_get, so
# writing here also sets the LED core cache that kbd-backlight-step relies on
# (its "cache starts at 0 after boot" caveat disappears).
#
# Escaping: $$ in a udev rule becomes a literal $ for the shell. The value is
# split on whitespace honoring the single quotes, so the whole sh -c body is
# one argument. /bin/sh, cat, test and echo all exist in the initramfs via
# busybox.
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="smc::kbd_backlight", RUN+="/bin/sh -c 'm=$$(cat /sys/class/leds/smc::kbd_backlight/max_brightness); [ $$m -gt 0 ] && echo $$((m/10)) > /sys/class/leds/smc::kbd_backlight/brightness'"
