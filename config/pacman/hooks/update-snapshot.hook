[Trigger]
# Fire on any package upgrade (covers pacman -Syu and single-package upgrades,
# including those run by paru). Install/Remove alone do not touch running
# system state, so they skip the snapshot.
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Snapshotting btrfs root before upgrade (rollback safety net)...
When = PreTransaction
Exec = /home/ajisrael/arch-setup/build/snapshot.sh --label pre-upgrade
AbortOnFail
