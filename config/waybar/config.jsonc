{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": ["hyprland/workspaces"],
  "modules-right": ["network", "cpu", "memory", "backlight", "pulseaudio", "bluetooth", "battery", "tray", "clock"],

  "hyprland/workspaces": {
    "format": "{name}"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M}"
  },
  "cpu": { "format": "\uf2db {usage}%" },
  "memory": { "format": "\uf85a {percentage}%" },
  "network": {
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "{icon} {ifname}",
    "format-disconnected": "{icon} off",
    "format-icons": {
      "wifi": ["\uf1eb"],
      "ethernet": ["\uf1e6"],
      "disconnected": ["\uf1eb"]
    },
    "tooltip-format": "{ifname}: {ipaddr}"
  },
  "backlight": {
    "format": "\ufa98 {percent}%",
    "on-click": "brightnessctl set +5%",
    "on-click-right": "brightnessctl set 5%-"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "{icon} muted",
    "format-icons": {
      "default": ["\uf027", "\uf028"],
      "muted": ["\uf026"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "bluetooth": {
    "format-disabled": "\uf5b1",
    "format-off": "\uf5b1 off",
    "format-on": "\uf5ae on",
    "format-connected": "\uf5af {device_alias}",
    "format-no-controller": "\uf5b1",
    "tooltip-format-on": "Bluetooth on",
    "tooltip-format-off": "Click to enable",
    "tooltip-format-disabled": "Bluetooth disabled",
    "tooltip-format-connected": "{device_alias} connected",
    "on-click": "/home/ajisrael/arch-setup/config/waybar/bluetooth-picker.sh",
    "on-click-right": "bluetoothctl power toggle"
  },
  "battery": {
    "bat": "BAT0",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-icons": ["\uf579", "\uf57b", "\uf57d", "\uf57f", "\uf581"],
    "format-charging": "\uf06d {capacity}%",
    "format-plugged": "\ufba3 {capacity}%",
    "format-warning": "\uf582 {capacity}%",
    "format-critical": "\uf582 {capacity}%",
    "format-time": "{H}:{m}",
    "tooltip-format": "{capacity}%  {time}"
  },
  "tray": { "spacing": 8 }
}
