{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": ["hyprland/workspaces"],
  "modules-right": ["network", "cpu", "memory", "backlight", "pulseaudio", "battery", "tray", "clock"],

  "hyprland/workspaces": {
    "format": "{name}"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%a %d %b %Y}"
  },
  "cpu": {
    "format": "\uf2db",
    "states": { "warm": 50, "hot": 80 },
    "tooltip-format": "{usage}%  {avg_frequency} GHz"
  },
  "memory": {
    "format": "\uf85a",
    "states": { "warm": 50, "hot": 80 },
    "tooltip-format": "{percentage}%  ({used:0.1f}G / {total:0.1f}G)"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "\uf1e6",
    "format-disconnected": "{icon}",
    "format-icons": {
      "wifi": ["\uf091f", "\uf0922", "\uf0925", "\uf0928"],
      "ethernet": ["\uf1e6"],
      "disconnected": ["\uf092d"]
    },
    "tooltip-format-wifi": "{essid}  {signalStrength}% ({signaldBm} dBm)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected"
  },
  "backlight": {
    "format": "\ufa98",
    "states": { "mid": 30, "bright": 60 },
    "tooltip-format": "{percent}%",
    "on-click": "brightnessctl set +5%",
    "on-click-right": "brightnessctl set 5%-"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "{icon}",
    "format-icons": {
      "default": ["\uf027", "\uf028"],
      "muted": ["\uf026"]
    },
    "tooltip-format": "{volume}%  {desc}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "battery": {
    "bat": "BAT0",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon}",
    "format-icons": ["\uf579", "\uf57b", "\uf57d", "\uf57f", "\uf581"],
    "format-charging": "\uf06d",
    "format-plugged": "\ufba3",
    "format-warning": "\uf582",
    "format-critical": "\uf582",
    "format-time": "{H}:{m}",
    "tooltip-format": "{capacity}%  {time}"
  },
  "tray": { "spacing": 8 }
}
